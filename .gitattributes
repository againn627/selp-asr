# Repo files themselves stay LF
* text=auto eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows batch files must keep CRLF, otherwise cmd can misparse them
*.bat text eol=crlf
*.cmd text eol=crlf
# install-runtime.ps1 needs CRLF + UTF-8 BOM: Windows PowerShell 5.1 reads a
# BOM-less UTF-8 file as ANSI and chokes on the Chinese comments.
*.ps1 text eol=crlf

# Everything else LF
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary
*.onnx binary
*.wav binary
*.png binary
*.gif binary
